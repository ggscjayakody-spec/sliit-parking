# ── Real backend (built in) ─────────────────────────────────────────
# Postgres connection string. On Vercel this is added for you when you connect a Neon database.
DATABASE_URL=
# Password the admin logs in with (the admin login is password only).
ADMIN_PASSWORD=
# Optional: your own secret for login tokens (otherwise derived from DATABASE_URL).
AUTH_SECRET=

# ── Or: demo mode, no database ──────────────────────────────────────
# Sample data kept in the browser. Set to 1 to use it.
NEXT_PUBLIC_DEMO_MODE=

# ── Or: a separate backend somewhere else ───────────────────────────
# NEXT_PUBLIC_API_URL=https://your-backend.example.com/api
